PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:root@localhost:5432/house_of_seya?schema=public"

JWT_ACCESS_SECRET="your_jwt_access_secret"
JWT_REFRESH_SECRET="your_jwt_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://localhost:3001"

UPLOAD_DIR="./uploads"
PUBLIC_MEDIA_URL="http://localhost:4000/uploads"

# Instagram feed on the storefront (long-lived token for @houseofseya.in; leave empty to use static images)
INSTAGRAM_ACCESS_TOKEN=""

# Public storefront origin (used for blog URLs in the blog sitemap)
SITE_URL="https://www.houseofseya.com"
