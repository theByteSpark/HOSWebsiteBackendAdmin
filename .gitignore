# ==========================================
# HOUSE OF SEYA - Backend + Admin
# Git Ignore
# ==========================================

# Environment / Secrets
.env
.env.*
!.env.example
!.env.sample

# Dependencies
node_modules/
client/node_modules/

# Build / Generated Output
dist/
build/
client/dist/
client/build/

# TypeScript generated files
*.tsbuildinfo

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Prisma
# Keep prisma/schema.prisma and prisma/migrations tracked
node_modules/.prisma/
node_modules/@prisma/client/

# Local databases
*.db
*.sqlite
*.sqlite3

# Prisma debug / temporary files
prisma/*.log

# Uploaded / Runtime Media
uploads/
storage/
media/
public/uploads/
public/media/

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.iml

# Temporary / Backup
*.tmp
*.temp
*.bak
*.backup
*~

# Testing / Coverage
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/
.vite/
.eslintcache

# Misc generated files
*.tgz
*.zip